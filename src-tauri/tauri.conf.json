{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Karsa",
	"mainBinaryName": "karsa",
	"version": "0.1.0",
	"identifier": "com.karsa.app",
	"build": {
		"beforeDevCommand": "bun x vite --config vite.config.tauri.ts",
		"devUrl": "http://localhost:5180/tauri-index.html",
		"beforeBuildCommand": "bun run build:web && bun run build:frontend:tauri",
		"frontendDist": "../dist-tauri"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"label": "main",
				"url": "tauri-index.html",
				"title": "Karsa",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"decorations": true,
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 22,
					"y": 24
				},
				"visible": false,
				"transparent": false,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost ws://localhost:* ws://127.0.0.1:* http://127.0.0.1:* https://api.github.com https://openrouter.ai; frame-src http://127.0.0.1:*; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data: blob: https:; font-src 'self' data:; media-src 'self' blob: https:;"
		}
	},
	"plugins": {
		"fs": {
			"requireLiteralLeadingDot": false
		},
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyRkI2MzUxRDFFOUQxQzEKUldUQjBlblJVV1A3UW1pYk1obkh1b1BMTWNmTXJjeW1oT0lWZWpPcVVsNjh1bTV3VlRSVWw2ckMK",
			"endpoints": [
				"https://github.com/lewyinn/karsa/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"externalBin": [
			"bin/rg"
		],
		"createUpdaterArtifacts": true,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"publisher": "lewyinn",
		"copyright": "Copyright © 2025 gnoviawan, 2026 mannnrachman, 2026 lewyinn (Karsa)",
		"category": "Productivity",
		"shortDescription": "Karsa - Personal AI-assisted multi-repo workspace",
		"longDescription": "Karsa is a personal desktop workspace built with Tauri by lewyinn (forked from Troupe) for multi-repo development, terminals, Git/GitHub workflows, Run Stack, and Env management.",
		"macOS": {
			"entitlements": "Entitlements.plist"
		},
		"windows": {
			"nsis": {
				"displayLanguageSelector": false
			},
			"wix": {
				"upgradeCode": "8a4f2c91-6e3b-4d7a-9c5e-1b2d3e4f5a6c"
			}
		}
	}
}
